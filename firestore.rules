rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Public catalog data is read-only for browsers. The JTube server (Admin SDK /
    // service account) manages videos, reels, channels and categories; client
    // writes are never trusted.
    match /videos/{videoId}            { allow read: if true; }
    match /reels/{reelId}              { allow read: if true; }
    match /shorts/{shortId}            { allow read: if true; }
    match /channels/{channelId}        { allow read: if true; }
    match /categories/{categoryId}     { allow read: if true; }
    match /ai_video_insights/{videoId} { allow read: if true; }

    // User profiles: anyone can read a public profile, only the owner can write it.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'avatarUrl', 'coverUrl', 'bio', 'createdAt', 'updatedAt'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /continueWatching/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community chat: signed-in users only, can only post as themselves, size-limited.
    match /jtube_group_chat/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Feedback: write-only, size-limited.
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() <= 5000;
    }
  }
}

{
  "entities": {
    "Video": {
      "title": "Video",
      "description": "Video document stored with external links and AI metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnail": { "type": "string" },
        "channel": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "baseLikes": { "type": "number" },
        "liked": { "type": "boolean" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "isShort": { "type": "boolean" },
        "playlist": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" },
        "aiLearned": { "type": "object" },
        "comments": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "title", "videoUrl"]
    },
    "AIVideoInsight": {
      "title": "AIVideoInsight",
      "description": "Information learned by AI during the 10-minute analysis of videos",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "channel": { "type": "string" },
        "category": { "type": "string" },
        "genre": { "type": "string" },
        "targetAudience": { "type": "string" },
        "depth": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "lastLearned": { "type": "number" }
      },
      "required": ["videoId", "genre", "lastLearned"]
    },
    "AISystemAudit": {
      "title": "AISystemAudit",
      "description": "Record of each 10-minute automated AI scan across all website videos",
      "type": "object",
      "properties": {
        "auditId": { "type": "string" },
        "timestamp": { "type": "number" },
        "totalVideosChecked": { "type": "number" },
        "totalShorts": { "type": "number" },
        "newVideosFound": { "type": "number" },
        "categories": { "type": "object" },
        "status": { "type": "string" }
      },
      "required": ["timestamp", "totalVideosChecked", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid"]
    },
    "ContinueWatching": {
      "title": "ContinueWatching",
      "description": "User watch progress bookmark",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "channel": { "type": "string" },
        "thumbnail": { "type": "string" },
        "videoUrl": { "type": "string" },
        "currentTime": { "type": "number" },
        "duration": { "type": "number" },
        "progressPercent": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["videoId", "currentTime", "timestamp"]
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

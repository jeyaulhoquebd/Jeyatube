# Copy this file to .env (never commit .env) and fill in your own values.

# ---- Required for the full YouTube library sync ----
# Google Cloud console → APIs & Services → Credentials → API key (enable "YouTube Data API v3").
# Restrict the key to the YouTube Data API.
YOUTUBE_API_KEY=

# ---- Admin studio login (admin.html) ----
# 1) Firebase Authentication: users with these UIDs are admins (comma-separated).
#    They sign in with their Firebase email + password; the server verifies the token.
ADMIN_FIREBASE_UIDS=4biDan5sHsZgfN33920XYQoNkH22
FIREBASE_PROJECT_ID=jeyatube
# 2) Backup login checked by the server itself (optional):
ADMIN_EMAIL=you@example.com
# Create the hash with:  npm run hash-password -- "a-long-unique-password"
ADMIN_PASSWORD_HASH=
# Random string of 32+ characters (keeps admins signed in across restarts)
SESSION_SECRET=

# ---- Optional AI / integrations (kept on the server, never sent to browsers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: instant new-upload push from YouTube (WebSub) ----
# Public https URL of this server, e.g. https://jtube.example.com
PUBLIC_BASE_URL=
# Random string used to verify YouTube's push notifications
WEBSUB_SECRET=

# ---- Tuning ----
PORT=3000
# Minutes between checks for new uploads (RSS, free)
SYNC_INTERVAL_MINUTES=5
# Max YouTube API units to spend per day (Google's default quota is 10,000)
YOUTUBE_QUOTA_LIMIT=9000
# Where the catalog is stored (use a persistent disk in production)
DATA_DIR=./data
